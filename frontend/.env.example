# Backend API. Keep /api when running Vite with the included proxy.
VITE_API_URL=/api
# Only used if you intentionally run the frontend without the backend.
VITE_DEV_OTP=123456
VITE_ADMIN_EMAIL=admin@barberqueue.local

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=barber_queue
